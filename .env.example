# Configuración local de desarrollo; cambiar antes de exponer el servicio.
POSTGRES_DB=asistencia
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=demo-change-me
DB_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=8088
DEMO_ADMIN_CODES=0000001
# Demostración académica: permite a ADMIN alterar y restaurar un payload desde Cadena.
# Solo funciona con el perfil demo. Usar false para ocultar y desactivar la simulación.
APP_CHAIN_ATTACK_ENABLED=true
# true al servir mediante HTTPS; localhost HTTP necesita false.
COOKIE_SECURE=false
MAX_ACCURACY_METERS=50
MAX_AGE_SECONDS=120
EARLY_MINUTES=15
LATE_MINUTES=15
